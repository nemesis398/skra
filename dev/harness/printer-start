#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Run the virtual printer in the foreground. Its make and model come from
# printer.attrs because ippeveprinter 2.4 prints its usage and exits when -a is
# combined with -M or -m. entrypoint.sh backgrounds it; the
# Makefile starts it again with "podman exec -d" after "printer-stop".
exec ippeveprinter -p 8631 -r off -k -d /var/spool/skra \
    -a /etc/skra/printer.attrs "Virtual MFC"
