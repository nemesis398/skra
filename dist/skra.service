[Unit]
Description=skrá print service
Requires=skra.socket
After=skra.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/skra
# Idle it stays under 50 MB. Saving a page as PNG, or turned as JPEG, holds
# the decoded page and a copy: about 110 MB at 600 dpi on A4, twice that on A3.
MemoryMax=256M
Restart=on-failure
NoNewPrivileges=true
